#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets and local machine config
.env
.env.*
*.keystore
*.jks
key.properties
# Committed upload keystore keeps GitHub APK signatures consistent across machines.
!android/keystore/
!android/keystore/balmi-upload.jks
!android/key.properties
android/local.properties
android/.gradle/

# Do not commit built APKs; ship them via GitHub Releases
*.apk
*.aab

# Docker / local data dumps
docker-data/
.gradle-home/
